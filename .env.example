# ========================================================
# CHATSIN FULLSTACK - PRODUCTION ENVIRONMENT GUIDE
# ========================================================

# --------------------------------------------------------
# 1. RENDER BACKEND CONFIGURATION (Set in Render Dashboard)
# --------------------------------------------------------
PORT=10000
NODE_ENV=production
FRONTEND_URL=https://chatsin.vercel.app

# PostgreSQL Database (Aiven PostgreSQL, Neon, Supabase, or Render PostgreSQL)
# Example: postgres://avnadmin:PASSWORD@pg-service-name.aivencloud.com:12345/defaultdb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatapp?schema=public

# Security
JWT_SECRET=generate_or_paste_a_strong_64_character_random_secret_here
JWT_EXPIRES_IN=30d

# Aiven Valkey / Redis (Optional / In-Memory Fallback)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USERNAME=default
VALKEY_PASSWORD=

# Aiven Kafka (Optional / Local Fallback)
KAFKA_BROKER=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=

# --------------------------------------------------------
# 2. VERCEL FRONTEND CONFIGURATION (Set in Vercel Dashboard)
# --------------------------------------------------------
# Set this to your Render service URL (e.g. https://chatsin-backend.onrender.com)
NEXT_PUBLIC_API_URL=https://chatsin-backend.onrender.com
NEXT_PUBLIC_WS_URL=https://chatsin-backend.onrender.com
