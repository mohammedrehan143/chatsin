# ========================================================
# CHATSIN BACKEND - ENVIRONMENT VARIABLES EXAMPLE
# ========================================================

# Server Configuration (Render assigns PORT automatically in production, e.g. 10000)
PORT=5000
NODE_ENV=development

# Frontend Origin URL (In production, replace with your Vercel URL, e.g. https://chatsin.vercel.app)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection
# Local: postgresql://postgres:postgres@localhost:5432/chatapp?schema=public
# Production (Aiven / Supabase / Neon / Render Postgres):
# postgres://avnadmin:PASSWORD@pg-service-name.aivencloud.com:12345/defaultdb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatapp?schema=public

# Security (Set a strong 64+ char secret in production)
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=30d

# --------------------------------------------------------
# Aiven Valkey / Redis Configuration
# --------------------------------------------------------
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USERNAME=default
VALKEY_PASSWORD=

# --------------------------------------------------------
# Aiven Kafka Configuration
# --------------------------------------------------------
KAFKA_BROKER=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=
