PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatapp?schema=public

# Security
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Cache / Aiven Valkey Preparation
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USERNAME=default
VALKEY_PASSWORD=

# Events / Aiven Kafka Preparation
KAFKA_BROKER=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=
